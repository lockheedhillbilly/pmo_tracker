# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Required for email parsing (process_email_updates.py) and paste-to-create in the dashboard.
ANTHROPIC_API_KEY=

# Where the digest email gets sent (can be the same as GMAIL_ADDRESS below).
PMO_TRACKER_DIGEST_TO=

# Gmail account send_digest.py/process_email_updates.py send from and read
# "PMO:"-tagged mail from, via IMAP/SMTP — not the Gmail REST API, since
# restricted-scope mail access there requires Google's paid CASA security
# review. Requires 2-Step Verification enabled on the account; generate the
# App Password at myaccount.google.com -> Security -> App Passwords.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional — defaults to a local tasks.db file next to the scripts if not set.
# Ignored once TURSO_DATABASE_URL is set below.
# PMO_TRACKER_DB_PATH=

# Hosted database (Turso — https://turso.tech, free tier). Leave both unset to
# keep using a local tasks.db file (e.g. for local dev/tests). Get these two
# values from the Turso web dashboard after creating a database — no CLI needed.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=
